generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id                String             @id @default(cuid())
  name              String?
  email             String?            @unique
  emailVerified     DateTime?          @map("email_verified")
  image             String?
  createdAt         DateTime           @default(now()) @map("created_at")
  updatedAt         DateTime           @updatedAt @map("updated_at")
  accounts          Account[]
  campaigns         Campaign[]
  leads             Lead[]
  sessions          Session[]
  emailAccounts     EmailAccount[]
  emailSuppressions EmailSuppression[]
  inboundEmails     InboundEmail[]

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String  @map("user_id")
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String? @db.Text
  id_token          String? @db.Text
  session_state     String? @db.Text
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model Company {
  id              String     @id @default(cuid())
  handle          String     @unique
  name            String
  website         String?
  industry        String?
  size            String?
  phone           String?
  address         String?
  city            String?
  state           String?
  country         String?
  countryCode     String?    @map("country_code")
  verifiedDomain  Boolean    @default(false) @map("verified_domain")
  researchSummary String?    @map("research_summary") @db.Text
  matchScore      Int        @default(0) @map("match_score")
  createdAt       DateTime   @default(now()) @map("created_at")
  updatedAt       DateTime   @updatedAt @map("updated_at")
  leads           Lead[]
  sources         Source[]
  evidences       Evidence[]

  @@map("companies")
}

model Campaign {
  id                 String          @id @default(cuid())
  name               String
  prompt             String          @db.Text
  status             String          @default("Ready")
  selectedLeadIds    Json
  selectedLeads      Json
  emails             Json
  personalizedEmails Json?
  connectedEmail     String?
  provider           String?
  emailAccountId     String?         @map("email_account_id")
  sentCount          Int             @default(0) @map("sent_count")
  failedCount        Int             @default(0) @map("failed_count")
  createdAt          DateTime        @default(now()) @map("created_at")
  updatedAt          DateTime        @updatedAt @map("updated_at")
  userId             String?         @map("user_id")
  user               User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  emailAccount       EmailAccount?   @relation(fields: [emailAccountId], references: [id], onDelete: SetNull)
  leads              Lead[]
  emailDeliveries    EmailDelivery[]
  inboundEmails      InboundEmail[]

  @@index([userId])
  @@map("campaigns")
}

model EmailDelivery {
  id            String         @id @default(cuid())
  campaignId    String         @map("campaign_id")
  leadId        String         @map("lead_id")
  step          Int
  recipient     String
  senderEmail   String?        @map("sender_email")
  subject       String         @db.Text
  body          String         @db.Text
  status        String         @default("Sending")
  messageId     String?        @map("message_id")
  gmailThreadId String?        @map("gmail_thread_id")
  error         String?        @db.Text
  sentAt        DateTime?      @map("sent_at")
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")
  campaign      Campaign       @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  inboundEmails InboundEmail[]

  @@unique([campaignId, leadId, step])
  @@index([campaignId, status])
  @@map("email_deliveries")
}

model Lead {
  id                  String     @id @default(cuid())
  companyId           String?    @map("company_id")
  companyRef          Company?   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  campaignId          String?    @map("campaign_id")
  campaign            Campaign?  @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  userId              String?    @map("user_id")
  user                User?      @relation(fields: [userId], references: [id], onDelete: SetNull)
  name                String
  firstName           String?    @map("first_name")
  lastName            String?    @map("last_name")
  jobTitle            String     @map("job_title")
  role                String
  function            String?
  company             String
  industry            String
  companySize         String?    @map("company_size")
  country             String
  state               String?
  city                String
  location            String
  companyHeadquarters String?    @map("company_headquarters")
  email               String
  domain              String?
  emailVerified       Boolean    @default(false) @map("email_verified")
  emailVerifyStatus   String?    @map("email_verify_status")
  verificationTag     String     @default("Review contact") @map("verification_tag")
  matchReason         String     @map("match_reason") @db.Text
  matchScore          Int        @default(0) @map("match_score")
  status              String     @default("Discovered")
  createdAt           DateTime   @default(now()) @map("created_at")
  updatedAt           DateTime   @updatedAt @map("updated_at")
  sources             Source[]
  evidences           Evidence[]

  @@index([companyId])
  @@index([campaignId])
  @@index([userId])
  @@map("leads")
}

model Source {
  id        String   @id @default(cuid())
  leadId    String?  @map("lead_id")
  lead      Lead?    @relation(fields: [leadId], references: [id], onDelete: Cascade)
  companyId String?  @map("company_id")
  company   Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)
  type      String
  url       String?  @db.Text
  title     String?
  rawData   Json?    @map("raw_data")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([leadId])
  @@index([companyId])
  @@map("sources")
}

model Evidence {
  id              String    @id @default(cuid())
  leadId          String?   @map("lead_id")
  lead            Lead?     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  companyId       String?   @map("company_id")
  company         Company?  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  type            String
  content         String    @db.Text
  confidenceScore Int       @default(0) @map("confidence_score")
  verifiedAt      DateTime? @map("verified_at")
  createdAt       DateTime  @default(now()) @map("created_at")

  @@index([leadId])
  @@index([companyId])
  @@map("evidences")
}

model JobResult {
  id         String   @id @default(cuid())
  jobId      String   @unique @map("job_id")
  userId     String?  @map("user_id")
  status     String
  totalFound Int      @default(0) @map("total_found")
  savedCount Int      @default(0) @map("saved_count")
  createdAt  DateTime @default(now()) @map("created_at")

  @@map("job_results")
}

model EmailAccount {
  id              String    @id @default(cuid())
  userId          String
  email           String
  displayName     String    @default("") @map("display_name")
  sendLockUntil   DateTime? @map("send_lock_until")
  accessToken     String?   @map("access_token") @db.Text
  refreshToken    String?   @map("refresh_token") @db.Text
  tokenExpiresAt  DateTime? @map("token_expires_at")
  gmailHistoryId  String?   @map("gmail_history_id")
  lastInboxSyncAt DateTime? @map("last_inbox_sync_at")
  status          String    @default("reconnect_required")
  createdAt       DateTime  @default(now())

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  campaigns     Campaign[]
  inboundEmails InboundEmail[]

  @@unique([userId, email])
}

model InboundEmail {
  id             String        @id @default(cuid())
  userId         String        @map("user_id")
  emailAccountId String        @map("email_account_id")
  campaignId     String        @map("campaign_id")
  deliveryId     String        @map("delivery_id")
  leadId         String        @map("lead_id")
  gmailMessageId String        @map("gmail_message_id")
  gmailThreadId  String        @map("gmail_thread_id")
  senderEmail    String        @map("sender_email")
  senderName     String?       @map("sender_name")
  recipientEmail String        @map("recipient_email")
  subject        String        @db.Text
  body           String        @db.Text
  receivedAt     DateTime      @map("received_at")
  createdAt      DateTime      @default(now()) @map("created_at")
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  emailAccount   EmailAccount  @relation(fields: [emailAccountId], references: [id], onDelete: Cascade)
  campaign       Campaign      @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  delivery       EmailDelivery @relation(fields: [deliveryId], references: [id], onDelete: Cascade)

  @@unique([emailAccountId, gmailMessageId])
  @@index([userId, receivedAt])
  @@index([campaignId, gmailThreadId])
  @@map("inbound_emails")
}

model EmailSuppression {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  email     String   @db.VarChar(191)
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, email])
  @@index([email])
  @@map("email_suppressions")
}
